# Demo settings, read by the scripts and loaded into the cluster as ConfigMaps.
CLUSTER_NAME=kcd-demo
TRUST_DOMAIN=kcd-budapest.demo
# The iss claim of every JWT-SVID. Must equal the issuer URL registered with Anthropic.
JWT_ISSUER=https://bonifaido.github.io/kcd-budapest-oidc
# Model for the stage curl.
MODEL=claude-haiku-5-5
