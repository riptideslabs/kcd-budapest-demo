# Copy to providers.env and fill in from the Claude Console (Settings > Workload identity).
# These are identifiers, not secrets; make reset puts them in the egress-proxy-config
# ConfigMap, which the proxy sidecar reads.
ANTHROPIC_ORGANIZATION_ID=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_SERVICE_ACCOUNT_ID=
ANTHROPIC_FEDERATION_RULE_ID=

# Optional: also add OpenAI tokens for api.openai.com (see the README).
# OPENAI_IDENTITY_PROVIDER_ID=
# OPENAI_SERVICE_ACCOUNT_ID=
# OPENAI_AUDIENCE=https://api.openai.com
